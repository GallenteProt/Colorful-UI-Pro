RichTextWidgetClass WRMCenter {
 ignorepointer 1
 position 0 0
 size 0.215 0.2
 halign center_ref
 valign center_ref
 hexactpos 0
 vexactpos 0
 hexactsize 0
 vexactsize 0
 priority 300
 font "gui/fonts/sdf_MetronBook24"
 "exact text" 1
 "exact text size" 24
 wrap 1
 "text halign" center
 "text valign" center
}
