    // The pause menu shows the date and time instead of the logo image: same widget, same font,
    // same colour and the same string as the main menu (MainMenu.DateTimeText / GetMenuDateTime).
    // The old Logo image is gone from this layout on purpose - it carried a baked-in word that is
    // not part of the brand, and the main menu does not show it either.
    TextWidgetClass DateTimeText {
     visible 1
     ignorepointer 1
     color 0.925 0.95 0.965 0.86
     position 0.008 0.089
     size 0.132 0.024
     halign left_ref
     valign top_ref
